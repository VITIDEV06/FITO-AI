{
  "name": "@fitoai/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "typecheck": "tsc --noEmit",
    "qvac:install": "npm install @qvac/sdk@0.19.0 react-native-bare-kit bare-rpc bare-pack expo-build-properties expo-device"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@fitoai/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.12",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.16",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-router": "~6.0.10",
    "expo-splash-screen": "~31.0.10",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "typescript": "^5.9.2"
  },
  "expo": {
    "comment": "Las dependencias de QVAC NO están aquí a propósito: pesan >1,5 GB y la app funciona sin ellas en Nivel 0. Instálalas con `npm run qvac:install` cuando vayas a integrar el motor con LLM."
  }
}
