{
  "name": "fitoai",
  "version": "2.0.0",
  "private": true,
  "description": "FitoIA — asistente agrícola móvil offline-first con IA local en el dispositivo.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run mobile",
    "test": "npm run test --workspace @fitoai/core",
    "typecheck": "npm run typecheck --workspace @fitoai/core",
    "build:core": "npm run build --workspace @fitoai/core",
    "mobile": "npm run start --workspace @fitoai/mobile",
    "android": "npm run android --workspace @fitoai/mobile",
    "seed": "node scripts/generar-seed.mjs",
    "desktop": "node packages/qvac-desktop/src/main.js",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "agricultura",
    "ia-local",
    "offline-first",
    "react-native",
    "expo",
    "qvac"
  ],
  "overrides": {
    "expo-asset": "~12.0.13",
    "expo-font": "~14.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "babel-preset-expo": "~54.0.12",
    "@babel/core": "^7.25.0"
  },
  "dependencies": {
    "expo": "~54.0.37",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
